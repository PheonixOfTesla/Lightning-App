{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/deals", "destination": "/deals.html" },
    { "source": "/calendar", "destination": "/calendar.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/partners", "destination": "/partners.html" },
    { "source": "/partner-portal", "destination": "/partner-portal.html" },
    { "source": "/members", "destination": "/members.html" },
    { "source": "/dashboard", "destination": "/members.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/host", "destination": "/host.html" },
    { "source": "/venue", "destination": "/venue.html" },
    { "source": "/dj", "destination": "/dj.html" },
    { "source": "/dj/:djId", "destination": "/dj.html" },
    { "source": "/dj-display/:djId", "destination": "/dj-display.html" },
    { "source": "/dj-banner/:djId", "destination": "/dj-banner.html" },
    { "source": "/dj-assets/:djId", "destination": "/dj-assets.html" },
    { "source": "/add-venue", "destination": "/add-venue.html" },
    { "source": "/objectives", "destination": "/objectives.html" },
    { "source": "/craig-proposal", "destination": "/craig-proposal.html" },
    { "source": "/black-flag-watersports-proposal", "destination": "/black-flag-watersports-proposal.html" },
    { "source": "/experiences", "destination": "/experiences.html" },
    { "source": "/lightning-perks", "destination": "/lightning-perks.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/receipt/:claimId", "destination": "/receipt.html" },
    { "source": "/pay/:linkId", "destination": "/pay.html" },
    { "source": "/sarasota-events", "destination": "/sarasota-events.html" },
    { "source": "/sarasota-nightlife", "destination": "/sarasota-nightlife.html" },
    { "source": "/sarasota-july-4th", "destination": "/sarasota-july-4th.html" },
    { "source": "/sarasota-things-to-do", "destination": "/sarasota-things-to-do.html" },
    { "source": "/siesta-key-events", "destination": "/siesta-key-events.html" },
    { "source": "/tampa-events", "destination": "/tampa-events.html" },
    { "source": "/sarasota-pool-party", "destination": "/sarasota-pool-party.html" },
    { "source": "/sarasota-events-this-weekend", "destination": "/sarasota-events-this-weekend.html" },
    { "source": "/downtown-sarasota-events", "destination": "/downtown-sarasota-events.html" },
    { "source": "/sarasota-concerts", "destination": "/sarasota-concerts.html" },
    { "source": "/sarasota-bars", "destination": "/sarasota-bars.html" },
    { "source": "/eventbrite-alternative-sarasota", "destination": "/eventbrite-alternative-sarasota.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/events/:slug", "destination": "/index.html" },
    { "source": "/venue/connect/return", "destination": "/index.html" },
    { "source": "/venue/connect/refresh", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
